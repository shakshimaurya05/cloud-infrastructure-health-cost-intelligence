# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL for CORS (comma-separated for multiple origins)
FRONTEND_URL=http://localhost:3000,http://localhost:5173

# AWS Configuration
# AWS SDK v3 automatically resolves credentials via the default provider chain:
# 1. Environment variables (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN)
# 2. Shared credentials file (~/.aws/credentials) via AWS_PROFILE
# 3. IAM Role for Amazon EC2 or Amazon ECS task role
# 4. AWS Single Sign-On (AWS IAM Identity Center)
AWS_REGION=us-east-1
# AWS_PROFILE=default

# Optional Explicit Credentials (NOT recommended for production - prefer IAM role or local profile)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Operating Mode:
# 'auto'  - Attempt live AWS queries. Fallback to mock DEMO mode if AWS credentials are unconfigured or fail.
# 'live'  - Strictly query AWS APIs. Return meaningful errors if AWS calls fail.
# 'demo'  - Always return mock demo data (ideal for frontend development without AWS access).
DEMO_MODE=auto

# Lookback Configuration
DEFAULT_METRICS_LOOKBACK_HOURS=24
DEFAULT_METRICS_PERIOD_SECONDS=3600
